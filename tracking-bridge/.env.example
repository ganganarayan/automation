# ---------------------------------------------------------------------------
# tracking-bridge environment variables
# Copy to .env and fill in. (shared) = Railway project-level variable.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=8080
TZ=Asia/Kolkata
LOG_LEVEL=info

# Database (shared)
DATABASE_URL=postgres://user:pass@localhost:5432/automation

# Razorpay
RAZORPAY_WEBHOOK_SECRET=

# Meta Conversions API
META_PIXEL_ID=
META_CAPI_TOKEN=
META_API_VERSION=v21.0
META_TEST_EVENT_CODE=
EVENT_SOURCE_URL=https://applygita.com
CONTENT_NAME=Emotional Clarity Consultation 121

# Meta Ads insights
META_AD_ACCOUNT_ID=
META_ADS_TOKEN=
INSIGHTS_SHEET_ID=
LOOKBACK_DAYS=1

# Assess360 enrichment
ASSESS360_URL=
ASSESS360_TOKEN=

# Google service account JSON (shared)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alerts (shared SMTP)
ALERT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Module toggles
MODULE_CAPI_ENABLED=true
MODULE_INSIGHTS_ENABLED=true
