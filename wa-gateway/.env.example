# ---------------------------------------------------------------------------
# wa-gateway environment variables
# Copy to .env and fill in. Values marked (shared) are Railway project-level
# variables; the rest are wa-gateway service variables.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=8080
TZ=Asia/Kolkata
LOG_LEVEL=info

# Database (shared project variable)
DATABASE_URL=postgres://user:pass@localhost:5432/automation

# Evolution API (service variable) -- ROTATE the key before deploy
EVOLUTION_BASE_URL=http://evolution-api.railway.internal
EVOLUTION_API_KEY=replace-me

# Google service account JSON (shared) -- single-line JSON string
GOOGLE_SERVICE_ACCOUNT_JSON=

# WhatsApp message templates sheet
TEMPLATES_SHEET_ID=
TEMPLATES_SHEET_TAB=WA Msg Templates

# Form-booking calendar link
CALENDAR_LINK=https://cal.example.com/book

# Emotional-outreach audio banks: JSON map band -> [two direct-download URLs]
AUDIO_BANDS={"critical":[],"overwhelmed":[],"strained":[],"stable":[]}

# Alerts
ALERT_EMAIL=connect@applygitawisdom.com

# SMTP (shared) -- Gmail app password compatible
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Internal / admin auth
INTERNAL_API_KEY=replace-me           # shared project variable
ADMIN_KEY=replace-me

# Dispatcher throttle / send window
GAP_MIN_SECONDS=180
GAP_MAX_SECONDS=240
SEND_WINDOW_START=6
SEND_WINDOW_END=24
DISPATCHER_TICK_SECONDS=15
MAX_SEND_ATTEMPTS=200

# Module toggles (default on unless noted)
MODULE_CRM_RELAY_ENABLED=true
MODULE_DISPATCHER_ENABLED=true
MODULE_RAW_RELAY_ENABLED=true
MODULE_FORM_BOOKING_ENABLED=true
MODULE_EMOTIONAL_OUTREACH_ENABLED=true
MODULE_CONNECTION_MONITOR_ENABLED=true
MODULE_DELAY_RELAY_ENABLED=true
MODULE_ADMIN_ENABLED=true
