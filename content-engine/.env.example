# ---------------------------------------------------------------------------
# content-engine environment variables
# Copy to .env and fill in. (shared) = Railway project-level variable.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=8080
TZ=Asia/Kolkata
LOG_LEVEL=info

# Database (shared)
DATABASE_URL=postgres://user:pass@localhost:5432/automation

# Approval links / signing
APP_SECRET=replace-me-long-random
PUBLIC_BASE_URL=https://content-engine.example.com

# Google service account JSON (shared) -- single-line JSON string
GOOGLE_SERVICE_ACCOUNT_JSON=

# AI providers -- ROTATE the Post for Me key before deploy (previous key leaked)
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
TEXT_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=models/gemini-3.1-flash-image

# Post for Me
POSTFORME_API_KEY=
PFM_GITA_ACCOUNTS=[]
PFM_VIDAPULSE_ACCOUNTS=[]
PFM_GITA_VIDEO_ACCOUNTS=[]
PFM_ACCOUNT_MAP={}

# Content sheets / Drive folders
GITA_SHEET_ID=
VIDAPULSE_SHEET_ID=
VIDEO_SHEET_ID=
FACTORY_SHEET_ID=
GITA_DRIVE_FOLDER_ID=
STRIP_FILE_ID=
VOICEOVER_FOLDER_ID=
REELS_FOLDER_ID=
FACTORY_GPT_FOLDER_ID=
FACTORY_GEMINI_FOLDER_ID=

# Video
JSON2VIDEO_API_KEY=

# Email (shared SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APPROVAL_EMAIL_GITA=
APPROVAL_EMAIL_VIDAPULSE=vidapulse.io@gmail.com
REPORT_EMAIL=

# Instagram comment automation
IG_AUTOMATION_URL=
IG_CONTACT_EMAIL=
IG_COMMENT_WEBHOOK_URL=

# wa-gateway internal send (shared INTERNAL_API_KEY)
WA_GATEWAY_URL=http://wa-gateway.railway.internal
INTERNAL_API_KEY=replace-me

# Admin
ADMIN_KEY=replace-me

# Assessment links
GITA_ASSESSMENT_LINK=https://applygita.com/assessment
GITA_SIMPLE_ASSESSMENT_LINK=https://assess.applygitawisdom.com/a/executive-emotional-stability-assessment

# Module toggles (video pipeline OFF by default)
MODULE_GITA_IMAGE_ENABLED=true
MODULE_VIDAPULSE_IMAGE_ENABLED=true
MODULE_VIDAPULSE_REFILL_ENABLED=true
MODULE_DELIVERY_ENABLED=true
MODULE_VIDEO_PIPELINE_ENABLED=false
MODULE_IMAGE_FACTORY_ENABLED=true
MODULE_DASHBOARD_ENABLED=true
MODULE_ADMIN_ENABLED=true
